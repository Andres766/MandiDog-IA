  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "boton-principal",
      "description": "Acción principal de la pantalla: lleno en teal, 48 dp de alto, ancho completo.",
      "html": "<button class=\"ds-btn-primary\">Escanear dientes</button>",
      "css": ".ds-btn-primary{font-family:'Nunito Sans',sans-serif;font-weight:700;font-size:16px;min-height:48px;padding:0 24px;border:none;border-radius:16px;background:#0F6E73;color:#fff;cursor:pointer;transition:background .2s}.ds-btn-primary:hover{background:#0C5D61}.ds-btn-primary:focus-visible{outline:3px solid #0F6E73;outline-offset:3px}.ds-btn-primary:active{background:#0A4F52}"
    },
    {
      "name": "Botón de contorno",
      "kind": "button",
      "refersTo": "boton-contorno",
      "description": "Acción secundaria, con ícono opcional (\"Escanear otro lado\", \"Reintentar\"). El color del contorno aproxima el rol outline derivado.",
      "html": "<button class=\"ds-btn-outline\">Escanear otro lado</button>",
      "css": ".ds-btn-outline{font-family:'Nunito Sans',sans-serif;font-weight:600;font-size:16px;min-height:48px;padding:0 24px;border:1px solid #6F797A;border-radius:16px;background:transparent;color:#0F6E73;cursor:pointer;transition:background .2s}.ds-btn-outline:hover{background:rgba(15,110,115,.08)}.ds-btn-outline:focus-visible{outline:3px solid #0F6E73;outline-offset:3px}"
    },
    {
      "name": "Botón flotante \"Agregar perro\"",
      "kind": "button",
      "refersTo": "boton-flotante",
      "description": "Acción principal de \"Mis perros\", abajo a la derecha.",
      "html": "<button class=\"ds-fab\">+ Agregar perro</button>",
      "css": ".ds-fab{font-family:'Nunito Sans',sans-serif;font-weight:700;font-size:16px;height:56px;padding:0 20px;border:none;border-radius:16px;background:#0F6E73;color:#fff;box-shadow:0 3px 6px rgba(0,0,0,.2);cursor:pointer}.ds-fab:hover{background:#0C5D61}.ds-fab:focus-visible{outline:3px solid #0F6E73;outline-offset:3px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "campo",
      "description": "Campo relleno con la lámina y contorno de Material con radio de 16 dp.",
      "html": "<label class=\"ds-field\"><span>Nombre</span><input value=\"Toby\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font-family:'Nunito Sans',sans-serif;font-size:13px;color:#3F484A}.ds-field input{font-family:'Nunito Sans',sans-serif;font-size:16px;min-height:48px;padding:0 14px;border:1px solid #6F797A;border-radius:16px;background:#FFFFFF;color:#1C2329}.ds-field input:focus-visible{outline:none;border:2px solid #0F6E73}"
    },
    {
      "name": "Tarjeta",
      "kind": "card",
      "refersTo": "tarjeta",
      "description": "Contenedor plano con borde de 1 dp; sin sombra.",
      "html": "<div class=\"ds-card\"><strong>Lo que encontró el análisis</strong><p>Inflamación de encías</p></div>",
      "css": ".ds-card{font-family:'Nunito Sans',sans-serif;background:#FFFFFF;border:1px solid #D3DADD;border-radius:16px;padding:16px;color:#1C2329}.ds-card p{margin:8px 0 0;line-height:1.5}"
    },
    {
      "name": "Placa de collar",
      "kind": "custom",
      "refersTo": "placa",
      "description": "La placa de cada perro: tono anodizado, perforación con aro de acero, nombre grabado y sello del último escaneo. Se mece desde la argolla al tocarla.",
      "html": "<div class=\"ds-tagwrap\"><button class=\"ds-tag\"><svg class=\"ds-ring\" width=\"46\" height=\"46\" viewBox=\"0 0 46 46\" aria-hidden=\"true\"><circle cx=\"23\" cy=\"23\" r=\"17\" fill=\"none\" stroke=\"#BAC4CA\" stroke-width=\"2\"/><circle cx=\"23\" cy=\"23\" r=\"14.2\" fill=\"none\" stroke=\"#66737B\" stroke-width=\"2\"/></svg><span class=\"ds-hole\"></span><span class=\"ds-tag-name\">Toby</span><span class=\"ds-tag-sub\">Pug · 3 años</span><span class=\"ds-stamp ds-stamp-red\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 3a1.6 1.6 0 0 1 1.6 1.6v9a1.6 1.6 0 1 1-3.2 0v-9A1.6 1.6 0 0 1 12 3zm0 14.2a1.9 1.9 0 1 1 0 3.8 1.9 1.9 0 0 1 0-3.8z\"/></svg>Consulta pronto</span></button></div>",
      "css": ".ds-tagwrap{background:#EEF2F3;padding:16px 16px 16px 24px}.ds-tag{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:4px;width:100%;text-align:left;border:none;cursor:pointer;background:#3B4752;color:#fff;border-radius:26px;padding:16px 16px 16px 48px;box-shadow:0 3px 8px rgba(0,0,0,.18);transform-origin:-10px 50%}.ds-tag .ds-ring{position:absolute;left:-16px;top:calc(50% - 23px)}.ds-hole{position:absolute;left:16px;top:calc(50% - 8px);width:16px;height:16px;border-radius:50%;background:#EEF2F3;box-shadow:inset 0 0 0 1px rgba(0,0,0,.22)}.ds-tag-name{font-family:'Varela Round',sans-serif;font-size:26px;line-height:1.1;letter-spacing:.2px}.ds-tag-sub{font-family:'Nunito Sans',sans-serif;font-size:15px;color:rgba(255,255,255,.86)}.ds-tag .ds-stamp{margin-top:8px}.ds-tag:focus-visible{outline:3px solid #0F6E73;outline-offset:3px}.ds-tag:active{animation:ds-swing .9s}@keyframes ds-swing{0%{transform:rotate(0)}15%{transform:rotate(2deg)}35%{transform:rotate(-1.2deg)}55%{transform:rotate(.6deg)}75%{transform:rotate(-.25deg)}100%{transform:rotate(0)}}@media (prefers-reduced-motion:reduce){.ds-tag:active{animation:none}}.ds-stamp{display:inline-flex;align-items:center;gap:6px;font-family:'Nunito Sans',sans-serif;font-weight:700;font-size:14px;padding:5px 10px;border-radius:10px;border:1.5px solid}.ds-stamp-red{background:#FEE2E2;color:#991B1B;border-color:rgba(153,27,27,.55)}"
    },
    {
