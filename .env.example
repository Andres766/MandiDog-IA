# Copia este archivo a .env para desarrollo local:  cp .env.example .env
# En Railway estas variables se definen en el panel del servicio, nunca en git.

# ---------------------------------------------------------------- Entorno
# development | test | staging | production
ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------- Autenticación
# firebase | dev
# dev acepta el header X-Dev-User sin verificar identidad.
# La API se niega a arrancar con AUTH_MODE=dev y ENV=production.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------- Base de datos
POSTGRES_USER=mandidog
POSTGRES_PASSWORD=mandidog_local
POSTGRES_DB=mandidog
# Puerto en tu máquina (5432 suele estar ocupado por otros proyectos)
POSTGRES_HOST_PORT=5436
# URLs vistas desde tu máquina. docker-compose las reescribe para la red interna.
DATABASE_URL=postgresql://mandidog:mandidog_local@localhost:5436/mandidog
TEST_DATABASE_URL=postgresql://mandidog:mandidog_local@localhost:5436/mandidog_test

# ------------------------------------- Almacenamiento (MinIO local / R2)
# Local: MinIO. Producción: https://<ACCOUNT_ID>.r2.cloudflarestorage.com y S3_REGION=auto
S3_ENDPOINT_URL=http://localhost:9000
# Host con el que se firman las URLs de subida: debe ser alcanzable por la app.
# Para probar desde un celular en la misma red usa http://<IP-LAN-de-tu-PC>:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=mandidog
S3_SECRET_ACCESS_KEY=mandidog_local_secret
S3_BUCKET=mandidog-images
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ----------------------------------------------------------------- Cargas
UPLOAD_URL_EXPIRES_SECONDS=300
UPLOAD_MAX_BYTES=10485760

# -------------------------------------------------------------- Inferencia
# stub | keras   (stub está prohibido con ENV=production)
INFERENCE_BACKEND=stub
# Probabilidad fija que devuelve el stub: 0.15 verde, 0.45 amarillo, 0.75 rojo
INFERENCE_STUB_PROBABILITY=0.15
# Ruta al .keras (junto a él debe estar el .json de metadatos que genera ml/)
INFERENCE_MODEL_PATH=

# ------------------------------------------------- Riesgo (PROVISIONALES)
# Bajos a propósito: se prefiere falso positivo a falso negativo.
# El valor definitivo sale del barrido de umbral en la validación cruzada de ml/.
RISK_THRESHOLD_YELLOW=0.30
RISK_THRESHOLD_RED=0.60

# -------------------------------------------------- Calidad de la imagen
QUALITY_MIN_SIDE_PX=224
# Varianza del laplaciano medida con el lado mayor reducido a 512 px
QUALITY_MIN_BLUR_VARIANCE=60
# Luminancia media 0-255
QUALITY_MIN_LUMINANCE=40
QUALITY_MAX_LUMINANCE=225

# --------------------------------------------------------- Consentimiento
# Versión del texto de autorización que muestra la app (docs/datos-y-consentimiento.md)
CONSENT_POLICY_VERSION=2026-11-v1

# --------------------------------------------------------------------- API
API_HOST_PORT=8008
